# ============================================================================
#  Environment configuration — DEVELOPMENT TEMPLATE (placeholders only)
#
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
#  .gitignore already excludes ".env*". Do not put real secrets anywhere in
#  source control or in documentation.
# ============================================================================

# MariaDB (XAMPP) connection string used by Prisma. Uses the "mysql" provider.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default XAMPP port is 3306. If your password contains special characters
# (e.g. / ? # @ : %), you MUST URL-encode them in the connection string.
#   PowerShell: [uri]::EscapeDataString('YourP@ss/word')
# Use the application-specific user (bpta_app), NOT root, for the app.
DATABASE_URL="mysql://bpta_app:YOUR_PASSWORD@127.0.0.1:3306/bpta_transport_dev"

# Secret used by Better Auth to sign/encrypt session tokens.
# Generate one with:  openssl rand -base64 32
# (PowerShell:  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})) )
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Canonical base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Public base URL exposed to the browser. Use https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Development-only administrator bootstrap ------------------------------
# Used ONLY by "npm run db:seed". Leave blank to skip admin creation.
# The seed script refuses to create an admin when NODE_ENV=production unless
# ALLOW_ADMIN_BOOTSTRAP=true is explicitly set. Never commit a real password.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="change-me-in-development"
SEED_ADMIN_NAME="Development Administrator"
