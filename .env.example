# ============================================================================
#  Environment configuration — DEVELOPMENT TEMPLATE (placeholders only)
#
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
#  .gitignore already excludes ".env*". Do not put real secrets anywhere in
#  source control or in documentation.
# ============================================================================

# MariaDB (XAMPP) connection string used by Prisma. Uses the "mysql" provider.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default XAMPP port is 3306. If your password contains special characters
# (e.g. / ? # @ : %), you MUST URL-encode them in the connection string.
#   PowerShell: [uri]::EscapeDataString('YourP@ss/word')
# Use the application-specific user (bpta_app), NOT root, for the app.
DATABASE_URL="mysql://bpta_app:YOUR_PASSWORD@127.0.0.1:3306/bpta_transport_dev"

# Secret used by Better Auth to sign/encrypt session tokens.
# Generate one with:  openssl rand -base64 32
# (PowerShell:  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})) )
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Canonical base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Public base URL exposed to the browser. Use https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sensitive passenger data encryption (Phase 4) --------------------------
# AES-256-GCM key for passenger identity numbers, mobile numbers and addresses.
# MUST be a 32-byte key: base64, or 64 hex characters.
# Generate one with (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Leave blank only if you will not use the passenger manifest module: writes
# to it FAIL CLOSED when no key is configured. Never commit the real key, and
# never reuse the same key outside local development.
#
# NOTE: this is a local environment variable, NOT a key-management service.
# Production use requires a managed KMS with rotation and revocation.
FIELD_ENCRYPTION_KEY=""

# --- Passenger manifest retention -------------------------------------------
# Stated minimum is 10 days and cannot be lowered. Automatic deletion is NOT
# implemented; this value only documents/records the intended period.
MANIFEST_RETENTION_DAYS="10"

# --- Synthetic demonstration data (development only) -------------------------
# "npm run db:seed" creates a handful of obviously-synthetic operators,
# vehicles, routes, permits, journeys, manifest entries, an inspection and an
# incident so the prototype is explorable immediately. Set to "false" to skip.
# Never enabled automatically in production.
SEED_DEMO_DATA="true"

# --- Development-only administrator bootstrap ------------------------------
# Used ONLY by "npm run db:seed". Leave BOTH email and password blank to skip
# admin creation. Set BOTH to create one development administrator.
#
# SEED_ADMIN_PASSWORD is intentionally EMPTY: there is no default credential.
# Supply a UNIQUE development password of at least 12 characters. The seed
# script rejects empty, short and well-known placeholder values, and never
# prints the password. Never commit a real password.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Development Administrator"
